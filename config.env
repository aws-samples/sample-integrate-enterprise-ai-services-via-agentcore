# =============================================================================
# config.env - Single source of truth for the demo deployment.
#
# Every environment-specific value the deploy/destroy scripts, CDK app, and
# gateway setup need is declared here. Nothing is hard-coded elsewhere.
# Copy nothing - edit this file in place, then run ./deploy.sh.
# =============================================================================

# ---- AWS target ----
export AWS_REGION="ap-northeast-1"
# Leave empty to auto-detect from `aws sts get-caller-identity`.
export AWS_ACCOUNT_ID=""

# ---- Naming ----
# Prefix applied to every resource so multiple demos can coexist in one account.
export PROJECT_NAME="agentcore-gw-demo"
export CLUSTER_NAME="${PROJECT_NAME}-eks"

# ---- EKS ----
export EKS_VERSION="1.31"
export EKS_NODE_INSTANCE_TYPE="t3.large"
export EKS_NODE_MIN=2
export EKS_NODE_MAX=4
export EKS_NODE_DESIRED=2

# ---- Container images ----
# ECR repo names (one per service). Registry URI is derived at deploy time.
export ECR_REPO_LANGGRAPH="${PROJECT_NAME}/langgraph-agent"
export ECR_REPO_CLAUDE="${PROJECT_NAME}/claude-agent"
export ECR_REPO_MCP="${PROJECT_NAME}/mcp-server"
export IMAGE_TAG="latest"

# ---- Bedrock (Service 2 uses real Bedrock via Claude Agent SDK) ----
# Inference profile / model id used by the Claude Agent service.
export BEDROCK_MODEL_ID="apac.anthropic.claude-sonnet-4-5-20250929-v1:0"

# ---- Cognito (inbound + outbound OAuth) ----
# Domain prefix must be globally unique within the region; a random suffix is
# appended by CDK if this collides. App client details are emitted as outputs.
export COGNITO_DOMAIN_PREFIX="${PROJECT_NAME}"

# ---- TLS for the ALB endpoints ----
# AgentCore Gateway targets MUST be https:// endpoints. Provide an ACM
# certificate ARN (in AWS_REGION) and the matching base domain you control.
# render-k8s.sh then attaches an HTTPS(443) listener to each service's ALB.
# If ACM_CERTIFICATE_ARN is empty the ALBs serve HTTP only - fine for local
# curl smoke tests, but the gateway targets cannot be created against them.
export ACM_CERTIFICATE_ARN=""
# Base domain that resolves to the ALBs (e.g. demo.example.com). You create the
# DNS records (CNAME/alias) after deploy prints the ALB hostnames.
export BASE_DOMAIN=""

# ---- AgentCore Gateway ----
export GATEWAY_NAME="${PROJECT_NAME}-gateway"
# MCP protocol version advertised by the gateway.
export GATEWAY_MCP_VERSION="2025-06-18"
# Enable semantic tool search on the gateway (SEMANTIC or empty for none).
export GATEWAY_SEARCH_TYPE="SEMANTIC"

# ---- Jira Cloud (Service 4 - external SaaS, no deployment) ----
# Fill these in (or edit services/jira-integration/config.json) to enable the
# Jira target. If JIRA_BASE_URL is empty, the Jira target is skipped.
export JIRA_BASE_URL=""                       # e.g. https://your-domain.atlassian.net
export JIRA_EMAIL=""                          # Atlassian account email (Basic auth)
# The API token itself is NEVER placed here. It is stored in AWS Secrets Manager
# and referenced by the credential provider. See docs/console-setup-guide.md.
export JIRA_API_TOKEN_SECRET_NAME="${PROJECT_NAME}/jira-api-token"

# ---- Deploy behaviour ----
# File where deploy.sh writes resolved outputs (endpoints, ARNs) for later steps.
export DEPLOY_OUTPUTS="deploy-outputs.env"
