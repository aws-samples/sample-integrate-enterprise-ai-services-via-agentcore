# =============================================================================
# config.example.env - template for the demo's single source of truth.
#
# This TEMPLATE is committed to git. Copy it to config.env (which is
# git-ignored) and edit that copy - config.env may hold account-specific or
# semi-sensitive values (account id, Jira email/URL) and must never be pushed:
#
#     cp config.example.env config.env
#     $EDITOR config.env        # set Bedrock model, optionally Jira; no secrets
#     ./deploy.sh
#
# Secrets (Cognito client secrets, the Jira API token) are NEVER placed in
# either file - they live in Cognito / AWS Secrets Manager and resolve at
# deploy time. Every value here is environment config, not a secret.
# =============================================================================

# ---- AWS target ----
export AWS_REGION="ap-northeast-1"
# Leave empty to auto-detect from `aws sts get-caller-identity`.
export AWS_ACCOUNT_ID=""

# ---- Naming ----
# Prefix applied to every resource so multiple demos can coexist in one account.
export PROJECT_NAME="agentcore-gw-demo"
export CLUSTER_NAME="${PROJECT_NAME}-eks"
# Short prefix for resources with tight name limits (ALB names cap at 32 chars).
export PROJECT_SHORT="acgw-demo"

# ---- EKS ----
export EKS_VERSION="1.31"
export EKS_NODE_INSTANCE_TYPE="t3.large"
export EKS_NODE_MIN=2
export EKS_NODE_MAX=4
export EKS_NODE_DESIRED=2

# ---- Container images ----
# ECR repo names (one per service). Registry URI is derived at deploy time.
export ECR_REPO_LANGGRAPH="${PROJECT_NAME}/langgraph-agent"
export ECR_REPO_CLAUDE="${PROJECT_NAME}/claude-agent"
export ECR_REPO_MCP="${PROJECT_NAME}/mcp-server"
export IMAGE_TAG="latest"

# ---- Bedrock (Service 2 uses real Bedrock via Claude Agent SDK) ----
# Inference profile / model id used by the Claude Agent service. Must be a valid
# inference profile in AWS_REGION - verify with:
#   aws bedrock list-inference-profiles --region ap-northeast-1
# In ap-northeast-1 (Tokyo) Claude Sonnet 4.5 is exposed under the jp. (Japan
# local) and global. prefixes - the apac. prefix does NOT include sonnet-4-5.
export BEDROCK_MODEL_ID="jp.anthropic.claude-sonnet-4-5-20250929-v1:0"

# ---- Cognito (inbound + outbound OAuth) ----
# Domain prefix must be globally unique within the region; a random suffix is
# appended by CDK if this collides. App client details are emitted as outputs.
export COGNITO_DOMAIN_PREFIX="${PROJECT_NAME}"

# ---- TLS / public endpoints (Amazon API Gateway) ----
# AgentCore Gateway targets MUST be https:// endpoints. Rather than terminate
# TLS on the ALBs (which would need an ACM cert + a domain you control), each
# service is fronted by an Amazon API Gateway HTTP API. Its built-in
# `https://{api-id}.execute-api.<region>.amazonaws.com` endpoint carries an
# AWS-managed, publicly trusted certificate - so NO custom domain and NO ACM
# certificate are required. The service ALBs stay internal + HTTP-only; API
# Gateway reaches them privately over a VPC Link.
#
# Each service is fronted by its own HTTP API. We use the special "$default"
# stage (auto-deploy) so the invoke URL has NO stage path segment - the
# execute-api base URL maps straight to the service root. This keeps every
# gateway target a clean base URL (no path rewriting).
# Where Cognito JWT validation happens. With API Gateway in front, the HTTP API
# JWT authorizer validates every inbound token before it reaches a service, and
# the services themselves live in private subnets reachable only via the VPC
# Link. So the in-pod auth check is disabled by default (AUTH_DISABLED=true).
# Set to "false" to ALSO enforce Cognito JWT inside each service (defense in
# depth); this is what the manual console-setup walkthrough demonstrates.
export AUTH_DISABLED="true"
# NOTE: HTTP API private integrations have a 30s hard timeout. All demo tools
# respond in well under that; a real long-lived MCP stream would need a
# different fronting (e.g. NLB + ACM). See docs/console-setup-guide.md.

# ---- AgentCore Gateway ----
export GATEWAY_NAME="${PROJECT_NAME}-gateway"
# MCP protocol version advertised by the gateway.
export GATEWAY_MCP_VERSION="2025-06-18"
# Enable semantic tool search on the gateway (SEMANTIC or empty for none).
export GATEWAY_SEARCH_TYPE="SEMANTIC"

# ---- Jira Cloud (Service 4 - external SaaS, no deployment) ----
# Fill these in to enable the Jira target. If JIRA_BASE_URL is empty, the Jira
# target is skipped.
export JIRA_BASE_URL=""                       # e.g. https://your-domain.atlassian.net
export JIRA_EMAIL=""                          # Atlassian account email (Basic auth)
# API token - two options (setup-gateway.py prefers JIRA_API_TOKEN if set):
#   RECOMMENDED: leave JIRA_API_TOKEN empty and store the token in AWS Secrets
#   Manager under JIRA_API_TOKEN_SECRET_NAME, e.g.
#     aws secretsmanager create-secret --name agentcore-gw-demo/jira-api-token \
#       --secret-string '{"api_token":"YOUR_TOKEN"}' --region ap-northeast-1
#   CONVENIENT: paste the token here. config.env is git-ignored so it will not be
#   committed, but it is still plaintext on disk - use Secrets Manager for
#   anything beyond a throwaway demo.
export JIRA_API_TOKEN=""                      # optional inline token (git-ignored)
export JIRA_API_TOKEN_SECRET_NAME="${PROJECT_NAME}/jira-api-token"

# ---- Deploy behaviour ----
# File where deploy.sh writes resolved outputs (endpoints, ARNs) for later steps.
export DEPLOY_OUTPUTS="deploy-outputs.env"
